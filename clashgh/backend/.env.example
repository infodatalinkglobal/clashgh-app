# === ClashGH backend (.env) ===
# Copy to .env and fill in values. .env is gitignored — never commit it.

# Server
PORT=3000
NODE_ENV=development

# Browser origins allowed in production (comma-separated) — e.g. the admin panel.
# Outside production every origin is allowed (Expo web preview).
#CORS_ORIGINS=https://admin.clashgh.app

# Database (Supabase Postgres in production; local Postgres in dev)
DATABASE_URL=postgresql://user:password@host:5432/clashgh

# Auth — 'stub' (local dev issuer that mimics Supabase Auth tokens) or 'supabase'
AUTH_PROVIDER=stub
STUB_JWT_SECRET=replace-with-a-long-random-string

# When AUTH_PROVIDER=supabase, provide these instead of STUB_JWT_SECRET
# (the Supabase project URL + project Settings > API > JWT secret):
#SUPABASE_URL=https://your-project.supabase.co
#SUPABASE_JWT_SECRET=your-supabase-jwt-secret
#SUPABASE_ANON_KEY=your-anon-key (reserved for future direct use)
#SUPABASE_SERVICE_ROLE_KEY=your-service-role-key (reserved for future direct use)
# Google OAuth client + magic link email are configured in the Supabase dashboard, not here.

# SMS provider — 'mock' logs OTPs to the server console (dev).
# Real Ghana provider (termii / africastalking / twilio) to be added
# to src/services/sms.js before launch, then set SMS_PROVIDER to it.
SMS_PROVIDER=mock
#SMS_API_KEY=your-sms-api-key
#SMS_SENDER_ID=ClashGH

# OTP
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Payments — 'stub' (dev: charges settled via /api/dev/paystack/simulate-charge)
# or 'live' (Module 1E: real Paystack API + signed webhooks)
PAYSTACK_MODE=stub
# For PAYSTACK_MODE=live (test keys during development, live keys for launch):
#PAYSTACK_SECRET_KEY=sk_test_xxx
#PAYSTACK_PUBLIC_KEY=pk_test_xxx
#PAYSTACK_WEBHOOK_SECRET=whsec_xxx (same as the secret key — HMAC SHA-512 of raw body)
#PAYSTACK_API_URL=https://api.paystack.co (override only for integration tests, e.g. the local mock)

# Business defaults (used from 1C onward)
DEFAULT_RESULT_WINDOW_MINUTES=30
DEFAULT_FIRST_PLACE_PERCENT=70
DEFAULT_RUNNERUP_PERCENT=20
DEFAULT_PLATFORM_PERCENT=10
REGISTRATION_PENDING_TTL_MINUTES=10
MIN_ENTRY_FEE_PESOWAS=1000
MIN_PRIZE_PESOWAS=1000
