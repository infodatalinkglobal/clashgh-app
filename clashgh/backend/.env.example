# === ClashGH backend (.env) ===
# Copy to .env and fill in values. .env is gitignored — never commit it.

# Server
PORT=3000
NODE_ENV=development

# Browser origins allowed in production (comma-separated) — e.g. the admin panel.
# Outside production every origin is allowed (Expo web preview).
#CORS_ORIGINS=https://admin.clashgh.app

# Database (Supabase Postgres in production; local Postgres in dev)
DATABASE_URL=postgresql://user:password@host:5432/clashgh

# Auth — 'stub' (local dev issuer that mimics Supabase Auth tokens) or 'supabase'
AUTH_PROVIDER=stub
STUB_JWT_SECRET=replace-with-a-long-random-string

# When AUTH_PROVIDER=supabase: SUPABASE_URL is required (user tokens are verified via its JWKS).
# SUPABASE_JWT_SECRET is only for older projects still on the legacy shared secret.
# (the Supabase project URL + project Settings > API > JWT secret):
#SUPABASE_URL=https://hrfqgmvnoavyxpumjbad.supabase.co
#SUPABASE_JWT_SECRET=your-supabase-jwt-secret
#SUPABASE_ANON_KEY=your-anon-key (reserved for future direct use)
#SUPABASE_SERVICE_ROLE_KEY=your-service-role-key (reserved for future direct use)
# Google OAuth client + magic link email are configured in the Supabase dashboard, not here.

# Notifications (Module 3E) — email + Expo push. No SMS/OTP (decision 2026-09-15).
# MAIL_PROVIDER: 'mock' prints emails to the server console (dev) | 'resend' (prod, free tier 3k/mo)
MAIL_PROVIDER=mock
#RESEND_API_KEY=re_xxx
#MAIL_FROM=ClashGH <no-reply@clashgh.app>   (a domain verified in Resend)
# PUSH_PROVIDER: 'mock' (dev) | 'expo' (prod — Expo Push API, no account needed;
# EXPO_ACCESS_TOKEN only if push security is enabled on the Expo project)
PUSH_PROVIDER=mock
#EXPO_ACCESS_TOKEN=
# Where admin alerts (new dispute, payout failed after retries) are emailed. Unset = skipped.
#ADMIN_ALERT_EMAIL=you@example.com

# Payments — 'stub' (dev: charges settled via /api/dev/paystack/simulate-charge)
# or 'live' (Module 1E: real Paystack API + signed webhooks)
PAYSTACK_MODE=stub
# For PAYSTACK_MODE=live (test keys during development, live keys for launch):
#PAYSTACK_SECRET_KEY=sk_test_xxx
#PAYSTACK_PUBLIC_KEY=pk_test_xxx
#PAYSTACK_WEBHOOK_SECRET=sk_live_xxx   (same value as PAYSTACK_SECRET_KEY: Paystack signs webhooks with it, hex HMAC SHA-512)
#PAYSTACK_API_URL=https://api.paystack.co (override only for integration tests, e.g. the local mock)

# Screenshot storage — 'local' (dev: backend/uploads-dev served at /uploads-dev)
# or 'cloudinary' (Module 3D). The app compresses to ≤500KB JPEG before upload.
SCREENSHOT_STORAGE=local
# Cloudinary (Module 3D): dashboard → Settings → API keys. Signed uploads happen
# server-side, so the secret never ships in the app. Free tier is ample.
#CLOUDINARY_CLOUD_NAME=xxx
#CLOUDINARY_API_KEY=xxx
#CLOUDINARY_API_SECRET=xxx
#CLOUDINARY_API_URL=https://api.cloudinary.com   (override only for test/mock-cloudinary.js)
#SCREENSHOT_RETENTION_DAYS=90                    (admin purge endpoint; never below 30)

# Business defaults (used from 1C onward)
DEFAULT_RESULT_WINDOW_MINUTES=30
DEFAULT_FIRST_PLACE_PERCENT=70
DEFAULT_RUNNERUP_PERCENT=20
DEFAULT_PLATFORM_PERCENT=10
REGISTRATION_PENDING_TTL_MINUTES=10
MIN_ENTRY_FEE_PESOWAS=1000
MIN_PRIZE_PESOWAS=1000

# Serve the web app from the API (same origin). Path to `mobile/web-dist` after `npm run web:export`.
#WEB_DIST=../mobile/web-dist

# Community hosts (marketplace): platform keeps this % of the host cut, host gets the rest.
#HOST_COMMISSION_PERCENT=50
#HOST_CUT_MAX_PERCENT=20
#HOST_MIN_ENTRY_PESEWAS=500

# Match scheduling: hours the two players have per round to agree a time and play
ROUND_WINDOW_HOURS=24

# Public website identity (canonical URLs, sitemap, schema.org, contact page)
SITE_ORIGIN=https://clashgh.app
SITE_LEGAL_NAME=ClashGH
SITE_CONTACT_EMAIL=support@clashgh.app
#SITE_CONTACT_PHONE=+233XXXXXXXXX
#SITE_TWITTER_HANDLE=@clashgh

# Abuse guards. Global per-IP ceiling on /api (per-route limits are fixed in code:
# join 10/10min, result 20/10min, schedule 30/10min, upload 15/10min,
# MoMo set 5/10min, host apply 3/h, host create 10/h). RATE_LIMIT_DISABLED=1 for tests only.
#RATE_LIMIT_API_PER_MINUTE=300

# Production refuses to boot with stub auth/payments/mail, local screenshots,
# empty CORS_ORIGINS or a non-https SITE_ORIGIN. ALLOW_UNSAFE_PRODUCTION=1 bypasses (staging only).

# Android App Links (https://clashgh.app/app/... opens the installed app).
# SHA-256 fingerprints of the signing certs, comma separated. Served at /.well-known/assetlinks.json.
#ANDROID_PACKAGE=com.clashgh.app
#ANDROID_SHA256_FINGERPRINTS=AA:BB:...
