{
  "name": "clashgh-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.mjs",
    "migrate:seed": "node scripts/migrate.mjs --seed",
    "migrate:check": "node scripts/migrate.mjs --check",
    "test": "RATE_LIMIT_DISABLED=1 node --test test/money.test.mjs test/schedule.test.mjs && node --test test/ratelimit.test.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  }
}
