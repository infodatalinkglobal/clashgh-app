# Where the ClashGH API lives, as seen from the admin's browser.
# In dev, leave empty to use the Vite proxy (/api → http://localhost:3000).
VITE_API_URL=
# 'stub' shows the dev-identity sign-in (backend AUTH_PROVIDER=stub);
# 'supabase' uses Supabase Auth (Google / magic link) — same as the app.
VITE_AUTH_MODE=stub
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
