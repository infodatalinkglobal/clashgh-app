# ClashGH mobile env (EXPO_PUBLIC_* vars are inlined at bundle time)

# API base URL.
# Physical Android device → host machine's localhost is 10.0.2.2 (or use
# "adb reverse tcp:3000 tcp:3000" and keep http://localhost:3000/api).
# LAN device → use the host's LAN IP.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api

# 'stub'  → dev mode: dev-identity sign-in against the backend's dev endpoints
# 'supabase' → production: Google OAuth + magic links via Supabase Auth
EXPO_PUBLIC_AUTH_MODE=stub

# Must match the backend's PAYSTACK_MODE ('stub' shows the dev simulate-payment panel)
EXPO_PUBLIC_PAYSTACK_MODE=stub

